# Copy this file to .env.local, then set your Foundry endpoint and model deployment.
# Browser login and server-to-Foundry identity are separate. Local browser login is bypassed.
FINANCE_COMPANION_ENVIRONMENT=development
FINANCE_COMPANION_DATA_BACKEND=json
FINANCE_COMPANION_LOCAL_JSON_PATH=.local-data/finance.json
FINANCE_COMPANION_DISABLE_AUTH_FOR_LOCAL_DEVELOPMENT=true
FINANCE_COMPANION_ALLOWED_EMAIL=local@example.test
FINANCE_COMPANION_SESSION_SECRET=local-dev-session-secret-change-me
VITE_AUTH_MODE=local
VITE_API_BASE_URL=http://localhost:8000/api/v1
FINANCE_COMPANION_CORS_ORIGINS=["http://localhost:5173"]

# Live mode: Foundry searches the public web and imports cited distribution facts.
# No market-data account, separate search resource/key, or source manifest is needed.
# Use stub only for an explicit offline demo.
FINANCE_COMPANION_DIVIDEND_RESEARCH_PROVIDER=azure_foundry
FINANCE_COMPANION_AZURE_FOUNDRY_ENDPOINT=
FINANCE_COMPANION_AZURE_FOUNDRY_DEPLOYMENT=
# Recommended low for GPT-6 Luna; leave blank for deployments without reasoning controls.
FINANCE_COMPANION_AZURE_FOUNDRY_REASONING_EFFORT=low
FINANCE_COMPANION_AZURE_FOUNDRY_AUTH_MODE=entra
# Leave blank for GA OpenAI v1.
FINANCE_COMPANION_AZURE_FOUNDRY_API_VERSION=
# Optional only for a user-assigned managed identity in Azure; leave blank locally.
FINANCE_COMPANION_AZURE_FOUNDRY_MANAGED_IDENTITY_CLIENT_ID=
# Sign in with az login. No Foundry API key is required in Entra mode.

# Optional browser Microsoft sign-in (not required for Foundry Entra authentication).
# To enable it, set VITE_AUTH_MODE=entra, DISABLE_AUTH_FOR_LOCAL_DEVELOPMENT=false,
# and configure the four values below plus your allowed email.
FINANCE_COMPANION_ENTRA_CLIENT_ID=
FINANCE_COMPANION_ENTRA_TENANT_ID=
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
