{
  "name": "@workspace/ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build --configLoader runner",
    "verify:dist-assets": "node scripts/verify-dist-assets.mjs",
    "verify:browser-security": "node scripts/verify-browser-security.mjs",
    "lint": "eslint .",
    "test": "vitest run --configLoader runner",
    "preview": "vite preview --configLoader runner"
  },
  "dependencies": {
    "@azure/msal-browser": "^4.26.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^15.12.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
    },
    "minimatch@10.2.6": {
      "brace-expansion": "5.0.9"
