FINANCE_COMPANION_ALLOWED_EMAIL=steveborgra@gmail.com
# Local-only opt-in. The API rejects this setting outside FINANCE_COMPANION_ENVIRONMENT=development.
FINANCE_COMPANION_DISABLE_AUTH_FOR_LOCAL_DEVELOPMENT=false
FINANCE_COMPANION_ENTRA_CLIENT_ID=your-entra-application-client-id
FINANCE_COMPANION_ENTRA_TENANT_ID=your-entra-directory-tenant-id
FINANCE_COMPANION_SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Development defaults to the deterministic stub. Non-development deployments must opt in explicitly.
FINANCE_COMPANION_DIVIDEND_RESEARCH_PROVIDER=stub
# Live AI provider: azure_foundry. Requires an Entra-only Foundry project endpoint,
# a policy-attached gpt-6-luna deployment, and explicitly approved agent versions.
FINANCE_COMPANION_AZURE_FOUNDRY_ENDPOINT=
FINANCE_COMPANION_AZURE_FOUNDRY_DEPLOYMENT=
FINANCE_COMPANION_AZURE_FOUNDRY_AGENT_NAME=dividend-history-agent
FINANCE_COMPANION_AZURE_FOUNDRY_STOCK_DETAILS_AGENT_NAME=stock-details-agent
# Live mode fails closed until the policy and these immutable versions are approved.
FINANCE_COMPANION_AZURE_FOUNDRY_AGENT_VERSION=
FINANCE_COMPANION_AZURE_FOUNDRY_STOCK_DETAILS_AGENT_VERSION=
FINANCE_COMPANION_AZURE_FOUNDRY_RAI_POLICY_ID=
# Recommended low for GPT-6 Luna; leave blank for deployments without reasoning controls.
FINANCE_COMPANION_AZURE_FOUNDRY_REASONING_EFFORT=low
# GA OpenAI v1 does not require an api-version; leave this empty.
FINANCE_COMPANION_AZURE_FOUNDRY_API_VERSION=
FINANCE_COMPANION_AZURE_FOUNDRY_AUTH_MODE=entra
FINANCE_COMPANION_CORS_ORIGINS=["http://localhost:5173"]
